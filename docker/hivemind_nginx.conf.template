worker_processes  5;
error_log /dev/stdout info;
worker_rlimit_nofile 8192;

events {
  worker_connections 4096;
}
http {
    access_log /dev/stdout;
    server {
            listen 0.0.0.0:80 default_server;
            server_name _;

            location / {
                    include rewrite_rules.conf;
                    # ${REWRITE_LOG} will be replaced by the docker entrypoint script.
                    # Set REWRITE_LOG=on in the environment to enable rewrite logging,
                    # otherwise it will remain disabled
                    ${REWRITE_LOG}

                    # PostgREST reads a GET argument whose value starts with a filter operator
                    # (`not.`, `eq.`, `in.`, ...) as a filter on the result, never as an argument,
                    # while every field of a form-encoded POST is an argument. So a GET of a
                    # function goes upstream as that POST, its query string becoming the body:
                    # each argument reaches the function verbatim, whatever it starts with.
                    # This runs after the rewrite rules, so it sees the path segments they turn
                    # into arguments too.
                    # PostgREST's reserved parameters stay in the query string, where they keep
                    # their meaning (in the body they would be arguments): `select`, `columns`,
                    # `on_conflict`, and any name whose last dot-separated part is `limit`,
                    # `offset`, `order`, `and` or `or` (`not.or`, `child.limit`), the names a
                    # GET straight to PostgREST takes for no argument either. Each part keeps
                    # its encoding and order.
                    rewrite_by_lua_block {
                        if ngx.req.get_method() == "GET" and ngx.var.uri:sub(1, 5) == "/rpc/" then
                            local reserved = { select = true, columns = true, on_conflict = true }
                            local reserved_last = { limit = true, offset = true, order = true, ["and"] = true, ["or"] = true }
                            local body, query = {}, {}
                            for part in (ngx.var.args or ""):gmatch("[^&]+") do
                                local name = ngx.unescape_uri((part:match("^[^=]*"):gsub("%+", " ")))
                                if reserved[name] or reserved_last[name:match("[^.]*$")] then
                                    query[#query + 1] = part
                                else
                                    body[#body + 1] = part
                                end
                            end
                            ngx.req.read_body()
                            ngx.req.set_method(ngx.HTTP_POST)
                            ngx.req.set_header("Content-Type", "application/x-www-form-urlencoded")
                            ngx.req.set_body_data(table.concat(body, "&"))
                            ngx.req.set_uri_args(table.concat(query, "&"))
                        end
                    }

                    proxy_pass  http://hivemind-postgrest-server:8080;  # my PostREST is  here!

                    proxy_set_header Host $host;
                    proxy_set_header X-Real-IP $remote_addr;
                    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                    #default_type;
                    proxy_hide_header Content-Location;
                    proxy_set_header  Connection "";
                    proxy_http_version 1.1;
            }
    }
    server {
        listen 0.0.0.0:81;

        location /health {
            return 204;
        }
    }
}
